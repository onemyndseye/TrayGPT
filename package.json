{
  "name": "TrayGPT",
  "version": "0.0.2a",
  "description": "Floating ChatGPT Overlay using Electron",
  "author": "onemyndseye",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "find dist -mindepth 1 ! -name '*.AppImage' -delete",
    "build": "electron-builder --linux AppImage && cd dist && sha256sum *.AppImage > TrayGPT.sha256sum"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.traygpt.app",
    "productName": "TrayGPT",
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "icon.png"
    },
    "publish": null,
    "files": [
      "**/*",
      "!node_modules/*",
      "!build_appimage.sh"
    ]
  }
}
