{
  "name": "TrayGPT",
  "version": "0.0.2b",
  "description": "Tray-based ChatGPT interface",
  "author": "onemyndseye",
  "main": "main.js",
  "scripts": {
    "prebuild": "mkdir -p dist && find dist -type f ! -name '*.AppImage' ! -name '*.exe' -delete",
    "build": "electron-builder --linux AppImage --win nsis && cd dist && find . -maxdepth 1 -type f \\( -name '*.AppImage' -o -name '*.exe' \\) -exec sha256sum {} + > TrayGPT.sha256sum"
  },
  "build": {
    "appId": "com.onemyndseye.traygpt",
    "productName": "TrayGPT",
    "files": [
      "**/*"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    },
    "win": {
      "target": ["nsis"]
    }
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  }
}
