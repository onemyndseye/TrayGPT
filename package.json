{
  "name": "TrayGPT",
  "version": "0.0.2b",
  "description": "Tray-based ChatGPT interface",
  "author": "onemyndseye",
  "main": "main.js",
  "scripts": {
    "build": "electron-builder --linux AppImage --win nsis"
  },
  "build": {
    "appId": "com.onemyndseye.traygpt",
    "productName": "TrayGPT",
    "publish": "never",
    "files": [
      "**/*"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    },
    "win": {
      "target": ["nsis"]
    }
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  }
}
