{
  "name": "TrayGPT",
  "version": "0.0.2b",
  "description": "Floating ChatGPT Overlay using Electron",
  "author": "onemyndseye",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "mkdir -p dist && find dist -type f ! -name '*.AppImage' ! -name '*.exe' -delete",
    "build": "electron-builder --linux AppImage --win nsis && cd dist && sha256sum *.{AppImage,exe} > TrayGPT.sha256sum"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.traygpt.app",
    "productName": "TrayGPT",
    "files": [
      "**/*",
      "!node_modules/*",
      "!build_appimage.sh"
    ],
    "publish": null,
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
